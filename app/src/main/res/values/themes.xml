<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IND210" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="MyEditTextStyle" parent="android:Widget.EditText">
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColorHint">@color/input_text_hint</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="MyEditTextStyleEnabled" parent="android:Widget.EditText">
        <item name="android:textColor">@color/input_text_hint_disabled</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColorHint">@color/input_text_hint_disabled</item>
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
