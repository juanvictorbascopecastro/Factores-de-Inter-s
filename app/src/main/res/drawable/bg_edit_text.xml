<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado: Deshabilitado -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_background_disabled" />
            <stroke android:width="1dp" android:color="@color/input_border_disabled" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Estado: Con foco (activo) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_background" />
            <stroke android:width="2dp" android:color="@color/input_border_focused" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Estado por defecto: Habilitado -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_background" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
